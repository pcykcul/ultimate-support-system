# Copy to .env and adjust. Every value has a sane default for local dev.

# Postgres connection
DATABASE_URL=postgres://uss:uss@localhost:5432/uss

# HTTP
PORT=3000
HOST=0.0.0.0

# Session cookie signing secret — set a long random value in production
SESSION_SECRET=change-me-to-a-long-random-string

# Base URL of this instance (used in emails and portal links)
APP_URL=http://localhost:3000

# Outbound email — pick ONE:
# Option A (recommended): Resend (https://resend.com) — just set the API key.
RESEND_API_KEY=
# Option B: SMTP. Leave both empty to log emails to stdout instead of sending (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Support <support@example.com>"

# Inbound email webhook shared secret (POST /api/inbound-email)
INBOUND_EMAIL_SECRET=change-me
